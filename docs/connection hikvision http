import requests
from requests.auth import HTTPDigestAuth
import xml.etree.ElementTree as ET

# Configuración del dispositivo , Este script sirve para testear la coneccion http
ip = '192.168.1.100'  
usuario = 'admin'     
contraseña = 'password' 

# URL para suscribirse a los eventos
url = f'http://{ip}/ISAPI/Event/notification/alertStream'

# Función para procesar los eventos entrantes
def procesar_evento(xml_data):
    root = ET.fromstring(xml_data)
    for evento in root.findall('EventNotificationAlert'):
        tipo_evento = evento.find('eventType').text
        hora_evento = evento.find('dateTime').text
        descripcion = evento.find('description').text
        print(f'Tipo de evento: {tipo_evento}')
        print(f'Hora del evento: {hora_evento}')
        print(f'Descripción: {descripcion}')
        print('---------------------------')

# Realizar la suscripción y procesamiento de eventos
with requests.get(url, auth=HTTPDigestAuth(usuario, contraseña), stream=True) as response:
    if response.status_code == 200:
        print('Conexión establecida. Esperando eventos...')
        for line in response.iter_lines():
            if line:
                procesar_evento(line.decode('utf-8'))
    else:
        print(f'Error al conectar: {response.status_code}')
